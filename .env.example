# Staging settings used by scripts/voltage-staging.
# Copy this file to .env, set the endpoints, then run: chmod 600 .env
# The wrapper reads this file directly; sourcing it is not required.
# It pins the CLI to the endpoints below and keeps staging CLI state isolated
# under .work/staging/cli.

# Required staging endpoints (https). Ask the team for the current hosts.
VOLTAGE_STAGING_API_URL='https://your-staging-api-host/v1'
VOLTAGE_STAGING_AUTH_URL='https://your-staging-auth-host/api/v1'

# Optional. Browser login and profiles need none of these. Set them only to
# run with an environment API key instead of a saved login or profile.
# VOLTAGE_API_KEY='your-environment-api-key'
# VOLTAGE_ORGANIZATION_ID='your-organization-uuid'
# VOLTAGE_ENVIRONMENT_ID='your-environment-uuid'

# Optional default wallet for API-key runs; profiles ignore it. Payment creation
# still fails unless a wallet is supplied here or with --wallet. Use only a
# staging test-network wallet.
# VOLTAGE_WALLET_ID='your-wallet-uuid'

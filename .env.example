# Staging credentials used by scripts/voltage-staging.
# Copy this file to .env, replace every required value, then run: chmod 600 .env
# The wrapper reads this file directly; sourcing it is not required.
# It pins the API to https://staging.voltageapi.com/v1 and keeps staging CLI
# state isolated under .work/staging/cli.

# Required environment-scoped API credentials and scope.
VOLTAGE_API_KEY='your-environment-api-key'
VOLTAGE_ORGANIZATION_ID='your-organization-uuid'
VOLTAGE_ENVIRONMENT_ID='your-environment-uuid'

# Optional default. Payment creation still fails unless a wallet is supplied
# here or explicitly with --wallet. Use only a staging test-network wallet.
# VOLTAGE_WALLET_ID='your-wallet-uuid'

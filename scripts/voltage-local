#!/usr/bin/env python3
"""Run the development CLI with isolated credentials and loopback endpoints."""
import os
from pathlib import Path
import shutil
import subprocess
import sys

root = Path(__file__).resolve().parents[1]
env = {key: value for key, value in os.environ.items() if not key.startswith('VOLTAGE_')}
args = sys.argv[1:]
if args == ['--build']:
    if not shutil.which('cargo') and (root / '.work/cargo/bin/cargo').exists():
        env.update(CARGO_HOME=str(root / '.work/cargo'), RUSTUP_HOME=str(root / '.work/rustup'))
        env['PATH'] = str(root / '.work/cargo/bin') + os.pathsep + env['PATH']
    sys.exit(subprocess.call(['cargo', 'build', '--locked'], cwd=root, env=env))
for arg in args:
    if arg.split('=')[0] in ('--config-dir', '--auth-url', '--api-url'):
        sys.exit('This local wrapper fixes its endpoints and credential directory; use target/debug/voltage for other configurations.')
binary = root / 'target/debug/voltage'
if not binary.is_file():
    sys.exit('Build the development CLI first: ./scripts/voltage-local --build')
os.execve(binary, [str(binary), '--config-dir', str(root / '.work/local-demo/cli'),
                  '--auth-url', 'http://127.0.0.1:8081/api/v1',
                  '--api-url', 'http://127.0.0.1:1/disabled-api', *args], env)
